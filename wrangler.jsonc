// Cloudflare Workers deployment: the site is the static files in site/, with no Worker code,
// served on danielcollison.dev and www.danielcollison.dev.
{
  "name": "website",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./site",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "danielcollison.dev", "custom_domain": true },
    { "pattern": "www.danielcollison.dev", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false
}
