// Cloudflare Workers deployment: the site is the static files in site/, with no Worker code.
// Custom domains are managed in the Cloudflare dashboard.
{
  "name": "website",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./site",
    "not_found_handling": "404-page"
  },
  "workers_dev": true,
  "preview_urls": false
}
